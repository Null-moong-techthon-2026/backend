# Example only. Copy to .env.staging and fill in your deployment values.
# Compose reads .env.staging as raw values: do not add shell quotes around values.
DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/boothluck?sslmode=verify-full&sslrootcert=/run/rds-ca/global-bundle.pem
DB_USERNAME=boothluck_app
DB_PASSWORD=REPLACE_WITH_APP_PASSWORD
FRONTEND_ORIGIN=https://frontend.invalid
FRONTEND_INVITE_BASE_URL=https://frontend.invalid/invite

# Keep local until the private S3 bucket and EC2 instance role are ready.
MEDIA_PROVIDER=local
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-southeast-2

# Optional; defaults to FRONTEND_ORIGIN + /invite/staff
FRONTEND_STAFF_INVITE_BASE_URL=https://frontend.invalid/invite/staff
# Explicit extra frontend origins; no wildcard. Also register the actual production origin when known.
FRONTEND_ADDITIONAL_ORIGINS=http://localhost:5173

# Demo-day only. Requires the prepared, fixed 2026-11-11 baseline. Disable after the demo.
DEMO_RESET_ENABLED=false
